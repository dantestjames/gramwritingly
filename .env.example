# --- Server ---
PORT=8787
# Public URL of the web app, used for CORS and links in emails
WEB_ORIGIN=http://localhost:5173
# Long random string. Signs session tokens.
JWT_SECRET=change-me-to-a-long-random-string
# SQLite database file
DATABASE_PATH=./data/gramwritingly.db

# --- LanguageTool (spelling and grammar) ---
# docker compose starts one at http://languagetool:8010
LANGUAGETOOL_URL=http://localhost:8010
# Default variant. en-AU, en-GB, en-US, en-CA, en-NZ, en-ZA
DEFAULT_LANGUAGE=en-AU

# --- Claude API (rewrites, tone, feedback, critiques) ---
ANTHROPIC_API_KEY=
# Fast model for sentence rewrites, tone shifts and synonyms
CLAUDE_FAST_MODEL=claude-haiku-5-5
# Stronger model for document feedback and chapter critiques
CLAUDE_DEEP_MODEL=claude-sonnet-5-5

# --- Plagiarism (Pro only) ---
# Provider: copyleaks | none
PLAGIARISM_PROVIDER=none
COPYLEAKS_EMAIL=
COPYLEAKS_API_KEY=
